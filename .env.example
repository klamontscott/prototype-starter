# Copy to .env.local and fill in real values. Never commit .env.local.

# Anthropic (server-side only — no NEXT_PUBLIC prefix, key must never reach the browser)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# PostHog (client-side, NEXT_PUBLIC prefix required)
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
